# Secrets: keep ESP-NOW keys, Wi-Fi credentials and tokens out of git
secrets.*
*.secret
*.env
.env*
config_local.*
credentials.*

# Build output and tool folders
build/
.pio/
.vscode/
.idea/
managed_components/
sdkconfig.old
*.elf
*.map

# Firmware images (Waveshare's factory image is their file, not ours)
*.bin

# Screensaver preview output
*.ppm
*.mp4
*.gif
*.png
*.bundle
screensaver/preview_out/
# ...except the curated renders in the Stage 1 report
!docs/screensaver/stage1-report/img/*.png
!docs/screensaver/stage1-report/img/*.mp4
!docs/screensaver/reviews/**
